{
  "version": "time-iter2",
  "patterns": [
    {
      "id": "TIME_CLOCK_RANGE_COLON",
      "subtype": "时刻区间",
      "priority": 100,
      "regex": "(?:(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)\\s*)?(?:[01]?\\d|2[0-3])\\s*[:：]\\s*[0-5]\\d\\s*(?:-|—|–|~|～|至|到)\\s*(?:(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)\\s*)?(?:[01]?\\d|2[0-3])\\s*[:：]\\s*[0-5]\\d"
    },
    {
      "id": "TIME_CLOCK_RANGE_DIAN",
      "subtype": "时刻区间",
      "priority": 99,
      "regex": "(?:(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)\\s*)?(?:[01]?\\d|2[0-3])\\s*点(?:半|[0-5]?\\d\\s*分|多)?\\s*(?:-|—|–|~|～|至|到)\\s*(?:(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)\\s*)?(?:[01]?\\d|2[0-3])\\s*点(?:半|[0-5]?\\d\\s*分|多)?"
    },
    {
      "id": "TIME_PERIOD_CLOCK_DIAN",
      "subtype": "时刻",
      "priority": 98,
      "regex": "(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)\\s*(?:[01]?\\d|2[0-3])\\s*点(?:半|[0-5]?\\d\\s*分|多)?"
    },
    {
      "id": "TIME_DATE_RANGE",
      "subtype": "日期区间",
      "priority": 97,
      "regex": "(?:(?:19|20)\\d{2}\\s*年\\s*)?(?:1[0-2]|0?[1-9])\\s*月\\s*(?:3[01]|[12]\\d|0?[1-9])\\s*[日号]\\s*(?:-|—|–|~|～|至|到)\\s*(?:(?:19|20)\\d{2}\\s*年\\s*)?(?:1[0-2]|0?[1-9])\\s*月\\s*(?:3[01]|[12]\\d|0?[1-9])\\s*[日号]"
    },
    {
      "id": "TIME_DATE_RANGE_SHORT",
      "subtype": "日期区间",
      "priority": 96,
      "regex": "(?:1[0-2]|0?[1-9])\\s*月\\s*(?:3[01]|[12]\\d|0?[1-9])\\s*[日号]\\s*(?:-|—|–|~|～|至|到)\\s*(?:3[01]|[12]\\d|0?[1-9])\\s*[日号]"
    },
    {
      "id": "TIME_DATE_CN",
      "subtype": "日期",
      "priority": 96,
      "regex": "(?:(?:19|20)\\d{2}\\s*年\\s*)?(?:1[0-2]|0?[1-9])\\s*月\\s*(?:3[01]|[12]\\d|0?[1-9])\\s*[日号]"
    },
    {
      "id": "TIME_DATE_ISO",
      "subtype": "日期",
      "priority": 95,
      "regex": "(?<!\\d)(?:19|20)\\d{2}[-/]\\d{1,2}[-/]\\d{1,2}(?!\\d)"
    },
    {
      "id": "TIME_CLOCK_COLON",
      "subtype": "时刻",
      "priority": 94,
      "regex": "(?<![\\d:：])(?:[01]?\\d|2[0-3])\\s*[:：]\\s*[0-5]\\d(?!\\d)"
    },
    {
      "id": "TIME_CLOCK_DIAN",
      "subtype": "时刻",
      "priority": 93,
      "regex": "(?<![\\d.])(?:[01]?\\d|2[0-3])\\s*点(?:半|[0-5]?\\d\\s*分|多)?"
    },
    {
      "id": "TIME_CLOCK_CN",
      "subtype": "时刻",
      "priority": 92,
      "regex": "(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)?\\s*[一二两三四五六七八九十]{1,3}\\s*点(?:半|[0-5]?\\d\\s*分|多)?"
    },
    {
      "id": "TIME_REL_DAY",
      "subtype": "相对日",
      "priority": 91,
      "regex": "(?:第\\s*[一二三四五六七八九十百\\d]{1,3}\\s*[天日]|(?:次|当|第二|第三|最后)\\s*天|Day\\s*0?\\d{1,2}|D\\s*\\d{1,2}|前一天|次日|翌日|当日)"
    },
    {
      "id": "TIME_MONTH_RANGE",
      "subtype": "月份区间",
      "priority": 90,
      "regex": "(?:[一二三四五六七八九十]{1,3}(?:\\s*[、,，]\\s*[一二三四五六七八九十]{1,3})+\\s*月|\\d{1,2}\\s*[-~～至]\\s*\\d{1,2}\\s*月)"
    },
    {
      "id": "TIME_SEASON",
      "subtype": "季节",
      "priority": 89,
      "regex": "(?:[春夏秋冬]\\s*季|春天|夏天|秋天|冬天)"
    },
    {
      "id": "TIME_HOLIDAY",
      "subtype": "节日",
      "priority": 88,
      "regex": "(?:春节|元宵节?|清明节?|劳动节|五一|十一|国庆节?|中秋节?|元旦|端午|暑假|寒假)"
    },
    {
      "id": "TIME_MONTH",
      "subtype": "月份区间",
      "priority": 80,
      "regex": "(?:(?:1[0-2]|0?[1-9])\\s*月|[一二三四五六七八九十]{1,3}\\s*月)"
    },
    {
      "id": "TIME_PERIOD",
      "subtype": "时段",
      "priority": 70,
      "regex": "(?:凌晨|清晨|早晨|早上|上午|中午|正午|下午|傍晚|晚上|夜里|夜间)"
    },
    {
      "id": "TIME_RECURRENCE",
      "subtype": "重复",
      "priority": 70,
      "regex": "(?:每天|每日|全天|全年)"
    },
    {
      "id": "TIME_DURATION",
      "subtype": "时长",
      "priority": 60,
      "regex": "(?:\\d+(?:\\.\\d+)?\\s*(?:个)?\\s*(?:小时|钟头|分钟|天|晚|个月)|[一二两三四五六七八九十百半]+(?:个)?\\s*(?:半小时|小时|钟头|分钟|天|晚|个月)|个来小时|个把小时|[一1]个多小时|两个半小时)"
    }
  ],
  "exclusions": [
    {
      "id": "EXCL_VIDEO_00",
      "regex": "(?:^|\\n)\\s*00:00\\s*(?=\\n|/|$)",
      "reason": "video_ui"
    },
    {
      "id": "EXCL_VIDEO_PAIR_LEFT",
      "regex": "00:00\\s*(?=/)",
      "reason": "video_ui"
    },
    {
      "id": "EXCL_VIDEO_PAIR_RIGHT",
      "regex": "/\\s*00:00",
      "reason": "video_ui"
    },
    {
      "id": "EXCL_DISTANCE",
      "regex": "\\d+(?:\\.\\d+)?\\s*(?:米|公里|千米)",
      "reason": "distance"
    },
    {
      "id": "EXCL_PRICE",
      "regex": "\\d+(?:\\.\\d+)?\\s*元",
      "reason": "price"
    },
    {
      "id": "EXCL_PRODUCT",
      "regex": "[一二两三四五六七八九十\\d]+日游",
      "reason": "product"
    }
  ]
}
