<node id="条件:颐和园:P6_否定建议:一般:一般建议避雷">
  <data key="d0">条件</data>
  <data key="d1">一般建议（避雷）</data>
  <data key="d2">[一般|P6] 一般建议（避雷）</data>
  <data key="d5">一般</data>
  <data key="d6">别忘了,来颐和园,赏西堤桃花只是其中之一</data>
  <data key="d7">13</data>
  <data key="d8">["一般建议（避雷）"]</data>
  <data key="d9">["别忘了,来颐和园,赏西堤桃花只是其中之一", "慎,避免贪小便宜,吃大亏", "别急着爬北城,你先往南城方向上几个台阶,很近,好汉碑在那儿等你去拍照呢,拍完照再折回来爬北城", "不建议走", "不要错过", "不要买联票,去哪个小景点单独买票", "别走,离主要景区太远了", "不要从东宫门进!进门全是上坡,全程累到崩溃,新手避雷", "不要乱雇门口野导游,套路多、讲解敷衍", "别买门口野生导游,官方公众号有免费语音导览", "不建议东宫门进,旅行团扎堆,人山人海", "不要硬打卡全部点位,挑重点慢走细逛", "不要买联票60"]</data>
  <data key="d10">["YHY-EXP04", "CTRIP_3941430", "CTRIP_4114227", "CTRIP_4076734", "CTRIP_4030611", "XHS_649263b10000000027001123", "XHS_6a7397cb000000000f03a401", "XHS_6ab51bbd000000001c02d84a", "XHS_6a9434700000000026000841", "XHS_6ae22af4000000003402822f", "XHS_68ad991d000000001d02b330"]</data>
  <data key="d11">[{"row_id": 7, "record_id": "YHY-EXP04", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "别忘了,来颐和园,赏西堤桃花只是其中之一"}, {"row_id": 598, "record_id": "CTRIP_3941430", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "慎,避免贪小便宜,吃大亏"}, {"row_id": 606, "record_id": "CTRIP_4114227", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "别急着爬北城,你先往南城方向上几个台阶,很近,好汉碑在那儿等你去拍照呢,拍完照再折回来爬北城"}, {"row_id": 617, "record_id": "CTRIP_4076734", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不建议走"}, {"row_id": 635, "record_id": "CTRIP_4030611", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要错过"}, {"row_id": 782, "record_id": "XHS_649263b10000000027001123", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要买联票,去哪个小景点单独买票"}, {"row_id": 786, "record_id": "XHS_6a7397cb000000000f03a401", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "别走,离主要景区太远了"}, {"row_id": 797, "record_id": "XHS_6ab51bbd000000001c02d84a", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要从东宫门进!进门全是上坡,全程累到崩溃,新手避雷"}, {"row_id": 799, "record_id": "XHS_6ab51bbd000000001c02d84a", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要乱雇门口野导游,套路多、讲解敷衍"}, {"row_id": 809, "record_id": "XHS_6a9434700000000026000841", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "别买门口野生导游,官方公众号有免费语音导览"}, {"row_id": 821, "record_id": "XHS_6ae22af4000000003402822f", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不建议东宫门进,旅行团扎堆,人山人海"}, {"row_id": 822, "record_id": "XHS_6ae22af4000000003402822f", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要硬打卡全部点位,挑重点慢走细逛"}, {"row_id": 825, "record_id": "XHS_68ad991d000000001d02b330", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要买联票60"}]</data>
</node>
<node id="条件:黄山:P6_否定建议:一般:一般建议避雷">
  <data key="d0">条件</data>
  <data key="d1">一般建议（避雷）</data>
  <data key="d2">[一般|P6] 一般建议（避雷）</data>
  <data key="d5">一般</data>
  <data key="d6">避免道路上的拥堵,节省体力时间,又可游玩精华景区</data>
  <data key="d7">18</data>
  <data key="d8">["一般建议（避雷）"]</data>
  <data key="d9">["避免道路上的拥堵,节省体力时间,又可游玩精华景区", "避免踩雷):", "不要说看景了", "不要错过哦!", "不要抱抱", "避免疫情扩散,老老实实窝在家里度过一个特别的春节,过了正月十五回到了工作的城市,熟悉的城市也失去了以往的", "不要让的士师傅拉,小心被宰", "慎选择饭店,很多饭店在门口写着超低菜品,其实价格不菲", "忌的光芒,更多了一份接纳万物的包容", "不要犹豫,索道是大部分人唯一的选择,专业选手请忽略", "不要轻易尝试", "不要停车费)", "避免背着沉重的行李走大峡谷,或者背着行李爬前山", "不要为“省”那点钱而错失了黄山最值得一去的地方", "不要移动,特别注意不要后退,以防不测", "不要在任何建筑物、古迹、岩石、竹木上题字刻画", "不建议买", "不要下到底,景色就已经很不错了,然后再原路上来,也不会太累"]</data>
  <data key="d10">["HS-O1", "CTRIP_4010240", "CTRIP_3989929", "CTRIP_4023752", "CTRIP_3951546", "CTRIP_3944634", "CTRIP_4032520", "CTRIP_4011981", "CTRIP_3947556", "CTRIP_3999208", "CTRIP_3995811", "CTRIP_1333628", "XHS_69f832f500000000230056c5", "XHS_67f6eff7000000001202c2d0"]</data>
  <data key="d11">[{"row_id": 11, "record_id": "HS-O1", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "避免道路上的拥堵,节省体力时间,又可游玩精华景区"}, {"row_id": 45, "record_id": "CTRIP_4010240", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "避免踩雷):"}, {"row_id": 87, "record_id": "CTRIP_3989929", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要说看景了"}, {"row_id": 93, "record_id": "CTRIP_4023752", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要错过哦!"}, {"row_id": 97, "record_id": "CTRIP_4023752", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要抱抱"}, {"row_id": 102, "record_id": "CTRIP_3951546", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "避免疫情扩散,老老实实窝在家里度过一个特别的春节,过了正月十五回到了工作的城市,熟悉的城市也失去了以往的"}, {"row_id": 140, "record_id": "CTRIP_3944634", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要让的士师傅拉,小心被宰"}, {"row_id": 155, "record_id": "CTRIP_4032520", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "慎选择饭店,很多饭店在门口写着超低菜品,其实价格不菲"}, {"row_id": 162, "record_id": "CTRIP_4011981", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "忌的光芒,更多了一份接纳万物的包容"}, {"row_id": 169, "record_id": "CTRIP_3947556", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要犹豫,索道是大部分人唯一的选择,专业选手请忽略"}, {"row_id": 179, "record_id": "CTRIP_3999208", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要轻易尝试"}, {"row_id": 195, "record_id": "CTRIP_3995811", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要停车费)"}, {"row_id": 258, "record_id": "CTRIP_1333628", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "避免背着沉重的行李走大峡谷,或者背着行李爬前山"}, {"row_id": 278, "record_id": "CTRIP_1333628", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要为“省”那点钱而错失了黄山最值得一去的地方"}, {"row_id": 280, "record_id": "CTRIP_1333628", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要移动,特别注意不要后退,以防不测"}, {"row_id": 281, "record_id": "CTRIP_1333628", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要在任何建筑物、古迹、岩石、竹木上题字刻画"}, {"row_id": 648, "record_id": "XHS_69f832f500000000230056c5", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不建议买"}, {"row_id": 650, "record_id": "XHS_67f6eff7000000001202c2d0", "pattern": "P6_否定建议", "frequency": 1, "condition": "一般建议（避雷）", "suggestion": "不要下到底,景色就已经很不错了,然后再原路上来,也不会太累"}]</data>
</node>
<node id="条件:黄山:P4_建议推断:一般:一般建议">
  <data key="d0">条件</data>
  <data key="d1">一般建议</data>
  <data key="d2">[一般|P4] 一般建议</data>
  <data key="d5">一般</data>
  <data key="d6">午后上山,与一日游旅客错峰出游</data>
  <data key="d7">76</data>
  <data key="d8">["一般建议"]</data>
  <data key="d9">["午后上山,与一日游旅客错峰出游", "天数:三至七天左右(不计往返时间)", "带多一件外套,注意保暖", "后山上前山下,这样走的比较舒服些", "小学课本上那篇关于黄山的内容了,但山上风景如画,自小就在大家心里留下了印象", "一条不少网友们实践后的一日游路线:", "节约时间买往返车票)-莲花峰或天都峰(两者交替开放)-迎客松-玉屏索道下山", "以下几处地点:西海排云亭、丹霞峰顶、飞来石、光明顶、步仙桥、莲花峰等处", "):2021年装修,设施最新", "买往返票", "大家最近出门提前了解当地政策", "记得要做核酸,遵守各地规则", "烧还原焰,对于白瓷,青花瓷,颜色釉等的釉面呈色效果良好", "慢跑,一侧是绿地鲜花,一侧是海水", "可以缓解跑步过程的枯燥", "选择一次索道", "查了下淘宝有很多黄山的店铺卖当季新茶的", "可以尝试下,不过这和从当地买感觉还是有差别的", "拍照,宝宝玩的也开心", "别错过哟", "精简登山行李", "可以准备个小包,登山杖也是必备神器", "带一些食品上山", "全家老小养精蓄锐之旅,保持愉悦的心情肆意享受青山绿水的惬意", "在山下购买轻便可及时充饥提供能量的食物", "在上山前购买一些轻便能够充饥的食物,既节约成本,又节省体力", "去年来到雲亼的时候,是一名住客的身份", "那时说道黄山雲亼,其“亼”,意是从入从一,三合也,象三合之形,古通\"集\"", "了拐杖,三个小伙仗着年轻,委婉点拒绝,不曾想这是多么后悔的决定", "可以看到许多步行登山看不到的风景,而且核心景区区域极大,可以节省体力看更美丽的风景,景色如图)", "的后山上前山下的路线游玩,即云谷索道上山,玉屏索道下山", "还是买把登山杖吧,总比轿子抬出来好些… 我爬到光明顶膝盖撑不住买了一把可伸缩的登山杖40元,良心价", "(来自20年来6次上黄山的亲身体验)", "体力非常好且不纠结看迎客松的人,此条线只看整个西海大峡谷风景,人少景美,你遇不到来黄山的绝大部分人,完美的避开人群,独享", "自由行,没有旅行团走这条线,北大门到西大门只能包车", "住山顶,一是节省体力,二是可以看日落、日出", "住山顶,除了贵点,没毛病", "慢悠悠的闲逛", "大家可以参考dz点评的推荐", "错峰出行游玩六道湾", "看日出日落的地方,我们爬上来的时候,这里已经挤满了人,等了5分钟左右,太阳就逐渐的接近西方的地平线了,看来晚也有晚的好处", "就别照了,会变成母老虎的:)", "让我们全家人开心的登顶莲花峰,领略的黄山的壮美,上下山安排的顺序也特别完美", "要赶在团队前面买票,不然你就等吧,缆车一次只能上50人", "2个景点:古牌坊群和花山迷窟,不过都是要自费的,老程不时搬出江泽民和黄山市委书记的故事说给我们听,可还是由于去的人太少", "温泉的好,什么洗一洗浑身解乏了等,最后有3个人禁不住诱惑去了温泉游泳池,不过也值了,游泳池可是为毛主席修的", "不要带香烟和明火上山,谢谢您的环保举动", "是一人一张床(地铺也成),能洗热水澡的,实在不行能有热水喝、能洗个热水脚的也成,价钱嘛自然是越低约好喽", "大声的招呼同伴们,和介绍人再三的确认后,我们开心的返回玉屏楼", "一下这锅鸡,虽然只是简单的整只清炖,但因为是放养的关系,鸡肉:紧实、有嚼劲、肉质鲜美", "鸡汤:就是一个字“醇”!那浓郁的醇", "要车票或记录车牌号码,以防万一", "也效仿一下我们的做法,约上几个游伴儿,大家联系好旅行的时间、确定好地点、预算、行程,推选出领队、费用共管人和记帐人员等", "从后山上(", "大家尽量以独卫床为主(性价比最高),标间价格过贵,公卫条件过差", "喝完的瓶子不要扔掉,在房间里可以自己灌水", "清澈甘醇,不含硫磺,是富含重碳酸盐的淡温泉,可饮可浴,且可防治某些疾病,有一定的医疗价值,又被称为“灵泉”", "游玩黄山的朋友选择自助游?这里简单说下原因", "拍照!西海大峡谷的路真的非常陡", ": 爬完山找个足浴按按脚,不然第二天真的会很疼", "索道,能省3h+景点都在索道上来之后,以及黄山的特点是上上下下翻山越岭,想爬山别急,坐玩索道后还有的爬", "冲锋衣,爬山热了可以脱掉中间层", "一上来就逛精华景点看风景、拍照状态拉满,不像常规路线,累到虚脱才到核心点位,人都没力气欣赏美景", "所有人来一次[害羞R]", "计算好时间,目标1点开始徒步", "建议最晚12:30要坐上交通车", "家人节奏最重要,量力而行", "把黄山放在旅行的最后一程,不然第二天腿疼会影响后面行程的体验感", "食用人群:", "先爬天都峰,体力最佳", "坐索道上山,因为云谷寺步行那段景色对比山上没有什么出彩的地方,不如把体力留给山上的风景点", "少走回头路,知道要走多少路真的很绝望", "走平缓点路线,最后都能到迎客松", "再加上“黄山归来不看岳”的响亮名头,我决定以黄山为重点,计划这次旅行", "放在第一站", "是离汤口镇南门游客中心(白色椭圆天桥)近一点的地方,爬完回去休息非常方便"]</data>
  <data key="d10">["HS-O1", "HS-EXTRA2", "CTRIP_4010240", "CTRIP_4050842", "CTRIP_4019387", "CTRIP_3951546", "CTRIP_3991429", "CTRIP_4004475", "CTRIP_4123390", "CTRIP_3961636", "CTRIP_3944634", "CTRIP_4032520", "CTRIP_4011981", "CTRIP_4017265", "CTRIP_3735942", "CTRIP_3947556", "CTRIP_3999208", "CTRIP_3995811", "CTRIP_4110889", "CTRIP_4109335", "CTRIP_3539977", "CTRIP_3976836", "CTRIP_940945", "CTRIP_811927", "CTRIP_898653", "CTRIP_1333628", "XHS_69f832f500000000230056c5", "XHS_69ca605e000000001d01c761", "XHS_69c8ce5300000000210055d2", "XHS_6ab28c740000000033010e68", "XHS_69c7e183000000002102f498", "XHS_688a0687000000002302e41d", "XHS_6a6b54ba000000002402e987", "XHS_6aa8cad1000000001103522b", "XHS_6aaf90bd000000000b00e86d", "XHS_6aa1db8500000000260329c4", "XHS_699db4740000000022039268", "XHS_6ac4f2f50000000002012ec2"]</data>
  <data key="d11">[{"row_id": 12, "record_id": "HS-O1", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "午后上山,与一日游旅客错峰出游"}, {"row_id": 14, "record_id": "HS-EXTRA2", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "天数:三至七天左右(不计往返时间)"}, {"row_id": 16, "record_id": "HS-EXTRA2", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "带多一件外套,注意保暖"}, {"row_id": 44, "record_id": "CTRIP_4010240", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "后山上前山下,这样走的比较舒服些"}, {"row_id": 48, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "小学课本上那篇关于黄山的内容了,但山上风景如画,自小就在大家心里留下了印象"}, {"row_id": 52, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "一条不少网友们实践后的一日游路线:"}, {"row_id": 53, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "节约时间买往返车票)-莲花峰或天都峰(两者交替开放)-迎客松-玉屏索道下山"}, {"row_id": 56, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "以下几处地点:西海排云亭、丹霞峰顶、飞来石、光明顶、步仙桥、莲花峰等处"}, {"row_id": 60, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "):2021年装修,设施最新"}, {"row_id": 64, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "买往返票"}, {"row_id": 69, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "大家最近出门提前了解当地政策"}, {"row_id": 70, "record_id": "CTRIP_4050842", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "记得要做核酸,遵守各地规则"}, {"row_id": 78, "record_id": "CTRIP_4019387", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "烧还原焰,对于白瓷,青花瓷,颜色釉等的釉面呈色效果良好"}, {"row_id": 103, "record_id": "CTRIP_3951546", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "慢跑,一侧是绿地鲜花,一侧是海水"}, {"row_id": 104, "record_id": "CTRIP_3951546", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "可以缓解跑步过程的枯燥"}, {"row_id": 107, "record_id": "CTRIP_3991429", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "选择一次索道"}, {"row_id": 111, "record_id": "CTRIP_4004475", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "查了下淘宝有很多黄山的店铺卖当季新茶的"}, {"row_id": 112, "record_id": "CTRIP_4004475", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "可以尝试下,不过这和从当地买感觉还是有差别的"}, {"row_id": 121, "record_id": "CTRIP_4123390", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "拍照,宝宝玩的也开心"}, {"row_id": 127, "record_id": "CTRIP_3961636", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "别错过哟"}, {"row_id": 144, "record_id": "CTRIP_3944634", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "精简登山行李"}, {"row_id": 145, "record_id": "CTRIP_3944634", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "可以准备个小包,登山杖也是必备神器"}, {"row_id": 146, "record_id": "CTRIP_3944634", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "带一些食品上山"}, {"row_id": 151, "record_id": "CTRIP_4032520", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "全家老小养精蓄锐之旅,保持愉悦的心情肆意享受青山绿水的惬意"}, {"row_id": 152, "record_id": "CTRIP_4032520", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "在山下购买轻便可及时充饥提供能量的食物"}, {"row_id": 156, "record_id": "CTRIP_4032520", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "在上山前购买一些轻便能够充饥的食物,既节约成本,又节省体力"}, {"row_id": 159, "record_id": "CTRIP_4011981", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "去年来到雲亼的时候,是一名住客的身份"}, {"row_id": 160, "record_id": "CTRIP_4011981", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "那时说道黄山雲亼,其“亼”,意是从入从一,三合也,象三合之形,古通\"集\""}, {"row_id": 163, "record_id": "CTRIP_4017265", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "了拐杖,三个小伙仗着年轻,委婉点拒绝,不曾想这是多么后悔的决定"}, {"row_id": 164, "record_id": "CTRIP_4017265", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "可以看到许多步行登山看不到的风景,而且核心景区区域极大,可以节省体力看更美丽的风景,景色如图)"}, {"row_id": 165, "record_id": "CTRIP_3735942", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "的后山上前山下的路线游玩,即云谷索道上山,玉屏索道下山"}, {"row_id": 172, "record_id": "CTRIP_3947556", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "还是买把登山杖吧,总比轿子抬出来好些… 我爬到光明顶膝盖撑不住买了一把可伸缩的登山杖40元,良心价"}, {"row_id": 175, "record_id": "CTRIP_3999208", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "(来自20年来6次上黄山的亲身体验)"}, {"row_id": 184, "record_id": "CTRIP_3999208", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "体力非常好且不纠结看迎客松的人,此条线只看整个西海大峡谷风景,人少景美,你遇不到来黄山的绝大部分人,完美的避开人群,独享"}, {"row_id": 185, "record_id": "CTRIP_3999208", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "自由行,没有旅行团走这条线,北大门到西大门只能包车"}, {"row_id": 187, "record_id": "CTRIP_3999208", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "住山顶,一是节省体力,二是可以看日落、日出"}, {"row_id": 188, "record_id": "CTRIP_3999208", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "住山顶,除了贵点,没毛病"}, {"row_id": 196, "record_id": "CTRIP_3995811", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "慢悠悠的闲逛"}, {"row_id": 205, "record_id": "CTRIP_4110889", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "大家可以参考dz点评的推荐"}, {"row_id": 212, "record_id": "CTRIP_4109335", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "错峰出行游玩六道湾"}, {"row_id": 226, "record_id": "CTRIP_3539977", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "看日出日落的地方,我们爬上来的时候,这里已经挤满了人,等了5分钟左右,太阳就逐渐的接近西方的地平线了,看来晚也有晚的好处"}, {"row_id": 227, "record_id": "CTRIP_3539977", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "就别照了,会变成母老虎的:)"}, {"row_id": 233, "record_id": "CTRIP_3976836", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "让我们全家人开心的登顶莲花峰,领略的黄山的壮美,上下山安排的顺序也特别完美"}, {"row_id": 234, "record_id": "CTRIP_940945", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "要赶在团队前面买票,不然你就等吧,缆车一次只能上50人"}, {"row_id": 239, "record_id": "CTRIP_811927", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "2个景点:古牌坊群和花山迷窟,不过都是要自费的,老程不时搬出江泽民和黄山市委书记的故事说给我们听,可还是由于去的人太少"}, {"row_id": 241, "record_id": "CTRIP_811927", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "温泉的好,什么洗一洗浑身解乏了等,最后有3个人禁不住诱惑去了温泉游泳池,不过也值了,游泳池可是为毛主席修的"}, {"row_id": 244, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "不要带香烟和明火上山,谢谢您的环保举动"}, {"row_id": 247, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "是一人一张床(地铺也成),能洗热水澡的,实在不行能有热水喝、能洗个热水脚的也成,价钱嘛自然是越低约好喽"}, {"row_id": 248, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "大声的招呼同伴们,和介绍人再三的确认后,我们开心的返回玉屏楼"}, {"row_id": 251, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "一下这锅鸡,虽然只是简单的整只清炖,但因为是放养的关系,鸡肉:紧实、有嚼劲、肉质鲜美"}, {"row_id": 252, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "鸡汤:就是一个字“醇”!那浓郁的醇"}, {"row_id": 254, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "要车票或记录车牌号码,以防万一"}, {"row_id": 255, "record_id": "CTRIP_898653", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "也效仿一下我们的做法,约上几个游伴儿,大家联系好旅行的时间、确定好地点、预算、行程,推选出领队、费用共管人和记帐人员等"}, {"row_id": 257, "record_id": "CTRIP_1333628", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "从后山上("}, {"row_id": 263, "record_id": "CTRIP_1333628", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "大家尽量以独卫床为主(性价比最高),标间价格过贵,公卫条件过差"}, {"row_id": 272, "record_id": "CTRIP_1333628", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "喝完的瓶子不要扔掉,在房间里可以自己灌水"}, {"row_id": 273, "record_id": "CTRIP_1333628", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "清澈甘醇,不含硫磺,是富含重碳酸盐的淡温泉,可饮可浴,且可防治某些疾病,有一定的医疗价值,又被称为“灵泉”"}, {"row_id": 274, "record_id": "CTRIP_1333628", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "游玩黄山的朋友选择自助游?这里简单说下原因"}, {"row_id": 645, "record_id": "XHS_69f832f500000000230056c5", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "拍照!西海大峡谷的路真的非常陡"}, {"row_id": 649, "record_id": "XHS_69f832f500000000230056c5", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": ": 爬完山找个足浴按按脚,不然第二天真的会很疼"}, {"row_id": 651, "record_id": "XHS_69ca605e000000001d01c761", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "索道,能省3h+景点都在索道上来之后,以及黄山的特点是上上下下翻山越岭,想爬山别急,坐玩索道后还有的爬"}, {"row_id": 655, "record_id": "XHS_69c8ce5300000000210055d2", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "冲锋衣,爬山热了可以脱掉中间层"}, {"row_id": 657, "record_id": "XHS_6ab28c740000000033010e68", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "一上来就逛精华景点看风景、拍照状态拉满,不像常规路线,累到虚脱才到核心点位,人都没力气欣赏美景"}, {"row_id": 659, "record_id": "XHS_69c7e183000000002102f498", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "所有人来一次[害羞R]"}, {"row_id": 663, "record_id": "XHS_688a0687000000002302e41d", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "计算好时间,目标1点开始徒步"}, {"row_id": 664, "record_id": "XHS_688a0687000000002302e41d", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "建议最晚12:30要坐上交通车"}, {"row_id": 667, "record_id": "XHS_6a6b54ba000000002402e987", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "家人节奏最重要,量力而行"}, {"row_id": 668, "record_id": "XHS_6a6b54ba000000002402e987", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "把黄山放在旅行的最后一程,不然第二天腿疼会影响后面行程的体验感"}, {"row_id": 669, "record_id": "XHS_6aa8cad1000000001103522b", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "食用人群:"}, {"row_id": 671, "record_id": "XHS_6aaf90bd000000000b00e86d", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "先爬天都峰,体力最佳"}, {"row_id": 672, "record_id": "XHS_6aa1db8500000000260329c4", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "坐索道上山,因为云谷寺步行那段景色对比山上没有什么出彩的地方,不如把体力留给山上的风景点"}, {"row_id": 674, "record_id": "XHS_6aa1db8500000000260329c4", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "少走回头路,知道要走多少路真的很绝望"}, {"row_id": 676, "record_id": "XHS_699db4740000000022039268", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "走平缓点路线,最后都能到迎客松"}, {"row_id": 680, "record_id": "XHS_6ac4f2f50000000002012ec2", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "再加上“黄山归来不看岳”的响亮名头,我决定以黄山为重点,计划这次旅行"}, {"row_id": 682, "record_id": "XHS_6ac4f2f50000000002012ec2", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "放在第一站"}, {"row_id": 686, "record_id": "XHS_6ac4f2f50000000002012ec2", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "是离汤口镇南门游客中心(白色椭圆天桥)近一点的地方,爬完回去休息非常方便"}]</data>
</node>
