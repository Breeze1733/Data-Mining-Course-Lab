ondition": "一般建议", "suggestion": "自带水和零食"}, {"row_id": 811, "record_id": "XHS_6ae191650000000035026c89", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "想全面体验的游客)"}, {"row_id": 812, "record_id": "XHS_6ae191650000000035026c89", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "穿一双舒适的运动鞋,暴走2万步是常态"}, {"row_id": 813, "record_id": "XHS_6a336311000000000802419f", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "驻足吹风、慢赏西堤湖景"}, {"row_id": 814, "record_id": "XHS_6adf124a000000001601ae2c", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "计划慢慢逛"}, {"row_id": 815, "record_id": "XHS_6adf124a000000001601ae2c", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "拍细节感满满的中式照片"}, {"row_id": 816, "record_id": "XHS_6adf124a000000001601ae2c", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "静看湖面,抬眼能看见玉峰塔藏在彩树之间,一路向前,远处佛香阁遥遥相望,适合拍摄大气舒展的远景"}, {"row_id": 817, "record_id": "XHS_6ae0a23c000000002b0014a0", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "带薄外套"}, {"row_id": 818, "record_id": "XHS_6abf929500000000180130dd", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "分次游览,拒绝赶路式打卡"}, {"row_id": 819, "record_id": "XHS_6ae22af4000000003402822f", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "安静拍氛围感照片不用抢机位"}, {"row_id": 826, "record_id": "XHS_6aacd64e0000000011034a18", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "游览顺序:佛香阁 → 昆明湖 → 十七孔桥 → 长廊 → 西堤"}, {"row_id": 827, "record_id": "XHS_6aacd64e0000000011034a18", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "携带有效证件)一定要在官方平台提前预约"}, {"row_id": 830, "record_id": "XHS_69bbb2340000000021011a19", "pattern": "P4_建议推断", "frequency": 1, "condition": "一般建议", "suggestion": "带身份证入园"}, {"row_id": 831, "record_id": "XHS_69bbb2340000000021011a19", "pattern": "P4_建议推断", "frequency": 1, "con