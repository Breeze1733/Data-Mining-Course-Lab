# Python（对全部 task 生效；统一使用根目录 .venv 共享环境）
__pycache__/
*.py[cod]
.venv/
venv/

# Node（task1 浏览器采集）
node_modules/

# 密钥与环境变量（任何层级，严禁入库）
.env
.env.*
!.env.example

# 系统与办公临时文件
.DS_Store
Thumbs.db
*.tmp
*.log
~$*.docx

# 根目录保持纯脚本入口，防止误建的 Python 工程文件入库
/.python-version
/uv.lock
/pyproject.toml

# 本地报告生成工具（不入库）
/local/

# 可由全链重建的中间产物（不入库，本地构建时重新生成）
task1/data/processed/cleaning_examples.json
task4/output/resolved_examples.json
