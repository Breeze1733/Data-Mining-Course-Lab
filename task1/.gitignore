# 实验项目1 的本地环境与临时文件
__pycache__/
*.py[cod]
node_modules/
.browser-profile*/
logs/
qa/
~$*.docx
*.tmp
report_template_backup.docx

# data/ 默认全部忽略：HTML 快照、中间产物、爬虫工作区（data/crawl/ 的断点缓存、
# 候选池、抓取日志）都可由 src/ 下的脚本再生。
# 只放行交付物与实验 2-7 的公共输入。
data/**
!data/raw/
!data/raw/official_documents.jsonl
!data/raw/official_routes.jsonl
!data/collected/
!data/collected/collection_summary.json
!data/collected/candidate_audit.jsonl
!data/collected/eligible_candidate_pool.csv
!data/collected/official_documents.jsonl
!data/collected/official_routes.jsonl
!data/collected/scenic_guide_dataset.xlsx
!data/processed/
!data/processed/dataset_clean.jsonl
!data/processed/quality_report.json
!data/processed/cleaning_examples.json
!data/processed/rejected_records.jsonl
